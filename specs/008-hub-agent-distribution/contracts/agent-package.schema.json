            "textarea",
            "select",
            "multiselect",
            "number",
            "boolean",
            "file",
            "directory"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "default_by_ui_language": {
          "type": "object",
          "additionalProperties": false,
          "properties": {

.DS_Store
/data
/node_modules
/resources/embedding-model
/resources/officecli
/resources/sherpa-onnx
/.npm-cache
/resources/runtime/.python-*
/resources/runtime/.uv-*
/resources/runtime/.node-*
/resources/runtime/node
/resources/runtime/python
/resources/runtime/uv
/resources/runtime/vc
/src/main/native/build/
/userWorkSpace
/venv

# Local multi-agent shared-file collaboration POC state
task.md
plan.md
.collab-poc/

# Local document/render outputs and workflow state
/.docx_render_*/
/.pdf_render_*/
/.superpowers/
/.codex-workflow/
/.zcode/
__pycache__/
*.py[cod]
*.tsbuildinfo

# Unrelated project snapshots and inspection material (never commit)
/.inspect-jiaoyu/
/builds/

# engine build artifacts
packages/*/node_modules
packages/*/dist

# electron-builder output and runtime render outputs
/dist
/output

# stray sidecar edits
package.json.new

# local build identity and development package output
/.build
/build-info.json
/dist-dev
build-info.json

# Local authoring tools and machine settings never belong to the release tree.
/.claude/

# Declares the intentional absence of the bundled deep scanner. Since the
# engine itself is not distributed in this repository, the marker is tracked
# so a fresh clone reports `scanner_absent` instead of `unknown`.
# Hermes desktop attachments (PRD/转写等敏感文件，勿入库)
/.hermes/

# WorkBuddy workspace memory (本地记忆/工作日志，不入库)
/.workbuddy/

# Private handoffs and implementation notes are kept outside the public tree.
/PROJECT_HANDOFF.md
/docs/plans/
/docs/changes/
/docs/design/
/docs/superpowers/
/design-qa/

# updates-server installer artifacts (large binaries; published via
# updates-server/publish.cjs which copies them here)
/updates-server/downloads/

# Internal dev skills must not be tracked in the public repo.
# Keep authoring tools outside the checkout.
/.agents/
.tmp-override-src-*/
.tmp-skill-import-*/
.tmp-skill-runner-*/

# Local Python environment for Spec Kit template composition.
/.venv-speckit/

# Release-source boundary: private work products live outside this checkout.
/.ai-product/
/.specify/
/specs/
/design/
/reports/
/skills/
/skills-lock.json
/AGENTS.md
/CLAUDE.md
/.goal-loop-ledger.md
/measure-baselines.cjs
/开发流程速查.md
/scripts/opensource/
/.github/workflows/
/.github/dependabot.yml
/.github/CODEOWNERS
/.gitleaks.toml
/test/private/
/community/PILOT_BACKLOG.zh-CN.md
/docs/*
!/docs/DEVELOPMENT.md
!/docs/DEVELOPMENT.zh-CN.md

# Generated caches, environments and build outputs.
/.pytest_cache/
/.venv*/
/coverage/
*.log
